# RECURRENTE_PUBLIC_KEY — pk_live_... or pk_test_...
RECURRENTE_PUBLIC_KEY=pk_test_

# RECURRENTE_SECRET_KEY — sk_live_... or sk_test_...
RECURRENTE_SECRET_KEY=sk_test_

# RECURRENTE_WEBHOOK_SECRET — found in Dashboard → Settings → Webhooks → [your endpoint]
# Format: whsec_<base64>
RECURRENTE_WEBHOOK_SECRET=whsec_

# --- Integration tests only ---
# A valid product_id from your Recurrente account (needed for subscriptions test)
RECURRENTE_TEST_PRODUCT_ID=prod_
# A valid price_id within that product
RECURRENTE_TEST_PRICE_ID=price_
